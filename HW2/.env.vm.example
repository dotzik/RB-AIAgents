# =============================================================================
# HW2 — běh na VM 101 (playground-dev) na Proxmoxu MERY.
#   cp .env.vm.example .env && docker compose up -d
#
# Oproti .env.example se mění jediný řádek: cesta k databázi. Zbytek je totožný,
# protože Spark je na LAN dostupný z notebooku i z VM stejně.
# Kontext a postup: docs/nasazeni-proxmox.md
# =============================================================================

# Na VM leží databáze mimo repozitář — repozitář se klonuje, data ne.
TIMEAGENT_DB_FILE=/opt/timeagent/data/timeagent.sqlite

# Adresa serveru s Ollamou. `OLLAMA_HOST_ONLY` je jen jeho hostitel —
# potřebuje ho LangFlow do výjimky z ochrany proti SSRF.
OLLAMA_BASE_URL=http://ollama.lan:11434
OLLAMA_HOST_ONLY=ollama.lan
OLLAMA_MODEL=qwen2.5:32b

API_PORT=8000
N8N_PORT=5678
LANGFLOW_PORT=7860

# -----------------------------------------------------------------------------
# Účty do obou platforem.
#
# n8n si vlastníka vynucuje — bez něj tě první načtení UI pošle na registraci.
# Nechat to na ručním proklikání znamená, že po `down -v` se to dělá znovu a že
# to nikdo jiný nezopakuje. Účet proto zakládá `scripts/init-accounts.ps1`
# z těchhle hodnot.
#
# LangFlow běží s LANGFLOW_AUTO_LOGIN=true, takže žádné přihlášení nemá.
# Pro nasazení mimo notebook to v docker-compose.yml přepni na false a odkomentuj
# superuživatele níž — na VM by veřejné UI bez loginu bylo hloupé.
#
# Nastav si vlastní hodnoty — tenhle soubor je v gitu, `.env` ne. Na VM je UI
# dostupné i mimo loopback, takže tady na hesle záleží víc než na notebooku.
# n8n chce heslo aspoň 8 znaků, alespoň jednu číslici a jedno velké písmeno.
# -----------------------------------------------------------------------------
N8N_OWNER_EMAIL=josef@localhost.local
N8N_OWNER_FIRST_NAME=Josef
N8N_OWNER_LAST_NAME=Dotzauer
N8N_OWNER_PASSWORD=ZmenSiHeslo1

# LANGFLOW_SUPERUSER=josef
# LANGFLOW_SUPERUSER_PASSWORD=ZmenSiHeslo1
