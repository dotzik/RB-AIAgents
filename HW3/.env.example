# =============================================================================
# HW3 — MCP server a agenti nad ním.
#   cp .env.example .env
#
# HW3 se připojuje do sítě, kterou vytváří HW2 (`rb-aiagents_hw2`), takže HW2
# stack musí běžet. Vlastní konfiguraci má ale svoji — HW2/.env se nesdílí.
# =============================================================================

# Databáze z HW1 — relativní cesta se počítá od tohoto adresáře.
# Vygeneruje ji `uv run timeagent seed` v HW1. Mountuje se read-only.
TIMEAGENT_DB_FILE=../HW1/data/timeagent.sqlite

# Port MCP serveru na hostiteli. Publikuje se jen na 127.0.0.1 a ::1.
# 8010, aby nekolidoval s HTTP API z HW2 na 8000 — obojí má běžet zároveň.
MCP_PORT=8010

# Port druhého, C# serveru (proxy nad API z HW2). Viz docs/dva-servery.md.
MCP_DOTNET_PORT=8011

# Hostitelé navíc pro ochranu proti DNS rebindingu. Výchozí seznam (mcp:8000,
# localhost:8010, …) je v mcp/src/timeagent_mcp/server.py; sem patří jen to,
# co přibude na konkrétním stroji, třeba hostname VM. Čárkou oddělené.
MCP_ALLOWED_HOSTS=

# Inference: tentýž model a tatáž adresa jako v HW2. Kdyby se lišily, srovnání
# klientů by měřilo model, ne framework.
OLLAMA_BASE_URL=http://ollama.lan:11434
OLLAMA_MODEL=qwen2.5:32b
# Digest modelu z /api/tags; jiný digest pod stejným tagem = jiný model
# (supply chain, security/04-mitigace.md, M8). Kontrola: security/check_model.py
OLLAMA_MODEL_DIGEST=9f13ba1299afea09d9a956fc6a85becc99115a6d596fae201a5487a03bdc4368

# Adresa MCP serveru pro agenty běžící na hostiteli (ne v kontejneru).
MCP_URL=http://127.0.0.1:8010/mcp
