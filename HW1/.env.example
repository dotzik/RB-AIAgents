# =============================================================================
# Poskytovatel LLM. Vybírá se odkomentováním jednoho bloku — kód se nemění.
# LiteLLM sjednotí tool calling napříč poskytovateli.
# =============================================================================

# --- VÝCHOZÍ: Ollama lokálně (zdarma, bez klíče) -----------------------------
TIMEAGENT_MODEL=ollama/llama3.2:3b
TIMEAGENT_API_BASE=http://localhost:11434

# --- LM Studio (lokálně, OpenAI-kompatibilní endpoint) -----------------------
# TIMEAGENT_MODEL=openai/qwen/qwen3-4b-2507
# TIMEAGENT_API_BASE=http://localhost:1234/v1
# OPENAI_API_KEY=not-needed

# --- Vzdálený lokální server na LAN (např. DGX Spark) ------------------------
# TIMEAGENT_MODEL=ollama/qwen3:14b
# TIMEAGENT_API_BASE=http://192.168.1.10:11434

# --- Anthropic (placené; klíč z console.anthropic.com) -----------------------
# POZOR: u cloudových poskytovatelů TIMEAGENT_API_BASE nenastavuj — kód ho pro ně
# záměrně ignoruje, aby zbytek po lokálním modelu neposlal dotaz na localhost.
# ceny za 1M tokenů:  Haiku 4.5  $1/$5   |  Sonnet 5  $2/$10  |  Opus 5  $5/$25
# TIMEAGENT_MODEL=anthropic/claude-opus-5
# TIMEAGENT_MODEL=anthropic/claude-sonnet-5
# TIMEAGENT_MODEL=anthropic/claude-haiku-4-5
# ANTHROPIC_API_KEY=

# --- OpenAI ------------------------------------------------------------------
# TIMEAGENT_MODEL=gpt-4o-mini
# OPENAI_API_KEY=

# --- OpenRouter --------------------------------------------------------------
# TIMEAGENT_MODEL=openrouter/meta-llama/llama-3.3-70b-instruct
# OPENROUTER_API_KEY=

# =============================================================================
# Databáze (volitelné) — jinak data/timeagent.sqlite
# =============================================================================
# TIMEAGENT_DB=D:/cesta/k/timeagent.sqlite

# =============================================================================
# Clockify (volitelné) — jen pro `timeagent import` s reálnými daty.
# Bez těchto proměnných projekt funguje na demo datech z `timeagent seed`.
# =============================================================================
# CLOCKIFY_API_KEY=
# CLOCKIFY_WORKSPACE_ID=
# CLOCKIFY_DEFAULT_RATE=1500
